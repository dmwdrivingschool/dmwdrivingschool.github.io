{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "web.drivemyway.co.uk"
        }
      ],
      "destination": "/admin.html",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "dmw-control-centre.vercel.app"
        }
      ],
      "destination": "/admin.html",
      "permanent": false
    },
    {
      "source": "/(index\\.html|admin\\.html|faq\\.html|pass-photos\\.html|contact\\.html|enquiry\\.html|enquiry-form\\.html|app-features\\.html|app-invite\\.html|cookies\\.html|passes\\.html|payments\\.html|prices\\.html|privacy\\.html|refund\\.html|terms\\.html|terms-of-use\\.html|withdraw\\.html)",
      "has": [
        {
          "type": "host",
          "value": "(?!web\\.)([a-z0-9-]+)\\.drivemyway\\.co\\.uk"
        }
      ],
      "destination": "/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), microphone=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://www.googletagmanager.com https://googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://web.drivemyway.co.uk https://cxcqmyxbpjueezapknim.supabase.co https://pub-b39e82262ee54e67a4cf08654290ea5c.r2.dev https://raw.githubusercontent.com https://www.google-analytics.com https://www.googletagmanager.com; media-src 'self' blob: https://cxcqmyxbpjueezapknim.supabase.co; connect-src 'self' https://cxcqmyxbpjueezapknim.supabase.co wss://cxcqmyxbpjueezapknim.supabase.co https://www.google-analytics.com https://region1.google-analytics.com https://www.googletagmanager.com https://raw.githubusercontent.com; frame-src 'self' blob: https://www.google.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/pass-wall.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/site.html"
    },
    {
      "source": "/(passes|prices|app|privacy|download|contact|terms)",
      "destination": "/site.html?page=$1"
    },
    {
      "source": "/auth/confirm",
      "destination": "/auth-confirm.html"
    },
    {
      "source": "/admin.html/auth/confirm",
      "destination": "/auth-confirm.html"
    },
    {
      "source": "/change-password",
      "destination": "/admin.html"
    }
  ]
}
